<?xml version="1.0" encoding="utf-8"?>
<!-- Mixtape's "Now playing" widget: the cassette with the cover on it, the song, and three keys. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mixtape_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mixtape_widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mixtape_widget_tape"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="@string/mixtape_widget_name"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1.15"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mixtape_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#F1E6CF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mixtape_widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#A99A88"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/mixtape_widget_prev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/mixtape_widget_prev"
                    android:src="@drawable/mixtape_widget_prev" />

                <ImageButton
                    android:id="@+id/mixtape_widget_play"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/mixtape_widget_key"
                    android:contentDescription="@string/mixtape_widget_play"
                    android:src="@drawable/mixtape_widget_play" />

                <ImageButton
                    android:id="@+id/mixtape_widget_next"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/mixtape_widget_next"
                    android:src="@drawable/mixtape_widget_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
