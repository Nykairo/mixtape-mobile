<?xml version="1.0" encoding="utf-8"?>
<!-- Mini player: one slim row with the cover, the song, play and next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mixtape_mini_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mixtape_widget_card"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/mixtape_mini_cover"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/mixtape_widget_cover"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mixtape_mini_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="#F6ECD8"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/mixtape_mini_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#A99A88"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageButton
                android:id="@+id/mixtape_mini_play"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/mixtape_widget_key"
                android:contentDescription="@string/mixtape_widget_play"
                android:scaleType="center"
                android:src="@drawable/mixtape_widget_play"
        android:layout_marginStart="6dp" />

    <ImageButton
                android:id="@+id/mixtape_mini_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/mixtape_widget_next"
                android:scaleType="center"
                android:src="@drawable/mixtape_widget_next" />
</LinearLayout>
