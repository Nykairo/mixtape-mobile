<?xml version="1.0" encoding="utf-8"?>
<!-- My tapes: up to eight of them as little cassettes in their own colors (WidgetArt.shelfTape), in as
     many columns and rows as the widget has room for. A tap opens the tape in Mixtape and plays it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mixtape_tapes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mixtape_widget_card"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.16"
        android:text="@string/mixtape_widget_tapes_caps"
        android:textColor="#FFB27A"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mixtape_tapes_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:drawableTop="@drawable/mixtape_widget_empty_tape"
        android:drawablePadding="10dp"
        android:gravity="center"
        android:text="@string/mixtape_widget_tapes_empty"
        android:textColor="#A99A88"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mixtape_tapes_row0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mixtape_tapes_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mixtape_widget_touch"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/mixtape_tapes_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mixtape_widget_touch"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/mixtape_tapes_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mixtape_widget_touch"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/mixtape_tapes_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mixtape_widget_touch"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mixtape_tapes_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mixtape_tapes_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mixtape_widget_touch"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/mixtape_tapes_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mixtape_widget_touch"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/mixtape_tapes_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mixtape_widget_touch"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/mixtape_tapes_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mixtape_widget_touch"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
