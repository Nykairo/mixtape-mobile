<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application>
        <!-- The "Now playing" widget for the home screen (and Samsung's widget stacks) -->
        <receiver
            android:name="dev.softwarevault.mixtape_native.NowPlayingWidget"
            android:exported="false"
            android:label="@string/mixtape_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mixtape_now_playing" />
        </receiver>
    </application>
</manifest>
